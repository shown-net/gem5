// Runtime-selectable research mechanism; baseline remains the original macroop.
let {{
    class Muls(BasicRegOp):
        op_class = 'IntMultOp'
        product_code = '''
            int64_t hi, low;
            switch (dataSize) {
              case 8:
                std::tie(hi, low) = mulSigned<int64_t>(PSrcReg1, op2);
                break;
              case 4:
                std::tie(hi, low) = mulSigned<int32_t>(PSrcReg1, op2);
                break;
              case 2:
                std::tie(hi, low) = mulSigned<int16_t>(PSrcReg1, op2);
                break;
              default:
                panic("Unrecognized IMUL data size %d.", dataSize);
            }
        '''
        code = product_code + 'DestReg = merge(DestReg, dest, low, dataSize);'
        big_code = product_code + 'DestReg = uint64_t(low) & mask(dataSize * 8);'
        flag_code = '''
            const unsigned n = dataSize * 8;
            const bool overflow = (uint64_t(hi) & mask(n)) !=
                (bits(uint64_t(low), n - 1) ? mask(n) : 0);
            cfofBits = overflow ? CfofMask : 0;
        '''

    microcode += '''
def macroop IMUL_R_R_SINGLE
{
    muls reg, reg, regm, flags=(OF,CF)
};
'''
}};
