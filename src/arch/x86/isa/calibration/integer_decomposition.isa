// Optional IMUL decomposition hypotheses. ALU immediates use v26's native
// full-width immediate micro-ops.
let {{
    for name, base in (("Mulswide", Muls),):
        fields = {field: getattr(base, field).replace("op2", "imm64")
                  for field in ("code", "big_code", "flag_code")}
        fields["operand_types"] = (FoldedDestOp, FoldedSrc1Op, Imm64Op)
        globals()[name] = type(name, (base,), fields)

    class Mulswidetemp(Mulswide):
        # The second op performs the architectural partial-register merge;
        # the multiply writes a complete temporary without an old-dest input.
        code = Mulswide.product_code.replace("op2", "imm64") + \
               'DestReg = uint64_t(low) & mask(dataSize * 8);'
        big_code = code

    microcode += '''
def macroop IMUL_R_M_DIRECT
{
    ld t1, seg, sib, disp
    muls reg, reg, t1, flags=(OF,CF)
};
def macroop IMUL_R_R_I_DIRECT
{
    mulswide reg, regm, imm, flags=(OF,CF)
};
def macroop IMUL_R_M_I_DIRECT
{
    ld t1, seg, sib, disp
    mulswide reg, t1, imm, flags=(OF,CF)
};
def macroop IMUL_R_R_I_SPLIT16
{
    mulswidetemp t1, regm, imm, flags=(OF,CF)
    mov reg, reg, t1
};
def macroop IMUL_R_M_I_SPLIT16
{
    ld t1, seg, sib, disp
    mulswidetemp t2, t1, imm, flags=(OF,CF)
    mov reg, reg, t2
};
'''
}};
