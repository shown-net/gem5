// Runtime-selectable behavior proxies for 32/64-bit GPR zero idioms.
// They preserve architectural result/flags and retirement, while separating
// source-dependency removal from functional-unit removal.
let {{
    class ZeroIdiomRegOp(RegOp):
        operand_types = (IntDestOp,)
        abstract = True
        code = 'DestReg = result = 0;'
        cond_control_flag_init = 'flags[IsZeroIdiom] = true;'

        def __init__(self, dest, flags=None, dataSize="env.dataSize"):
            super().__init__(dest, flags=flags, dataSize=dataSize)

    class Xorzeroalu(ZeroIdiomRegOp):
        flag_code = Xor.flag_code.replace("PSrcReg1", "uint64_t(0)") \
                                 .replace("op2", "uint64_t(0)")

    class Xorzeronofu(Xorzeroalu):
        op_class = "X86ZeroIdiomOp"

    class Subzeroalu(ZeroIdiomRegOp):
        flag_code = Sub.flag_code.replace("PSrcReg1", "uint64_t(0)") \
                                 .replace("op2", "uint64_t(0)")

    class Subzeronofu(Subzeroalu):
        op_class = "X86ZeroIdiomOp"

    microcode += '''
def macroop XOR_R_R_ZERO_DEP
{
    xorzeroalu reg, flags=(OF,SF,ZF,PF,CF,AF)
};
def macroop XOR_R_R_ZERO_NOFU
{
    xorzeronofu reg, flags=(OF,SF,ZF,PF,CF,AF)
};
def macroop SUB_R_R_ZERO_DEP
{
    subzeroalu reg, flags=(OF,SF,ZF,PF,CF,AF)
};
def macroop SUB_R_R_ZERO_NOFU
{
    subzeronofu reg, flags=(OF,SF,ZF,PF,CF,AF)
};
'''
}};
