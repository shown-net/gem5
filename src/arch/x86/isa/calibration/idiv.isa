// Runtime-selectable fixed-footprint behavior proxy for register DIV/IDIV.
let {{
    # The host calculation is atomic so
    # the ISA result is independent of model timing; the surrounding micro-ops
    # represent the observed three divider-side operations and one general
    # integer operation. The 64-bit form adds the official no-port footprint.
    compactUnsignedCode = '''
        const unsigned width = dataSize * 8;
        const uint64_t widthMask = mask(width);
        const unsigned __int128 dividend =
            (static_cast<unsigned __int128>(PSrcReg1 & widthMask) << width) |
            static_cast<unsigned __int128>(Rax & widthMask);
        const uint64_t divisor = op2 & widthMask;
        if (divisor == 0) {
            fault = std::make_shared<DivideError>();
        } else {
            const unsigned __int128 quotient = dividend / divisor;
            if (quotient > widthMask) {
                fault = std::make_shared<DivideError>();
            } else {
                Quotient = static_cast<uint64_t>(quotient);
                Remainder = static_cast<uint64_t>(dividend % divisor);
                Divisor = divisor;
            }
        }
    '''

    compactSignedCode = '''
        const unsigned width = dataSize * 8;
        const uint64_t widthMask = mask(width);
        const uint64_t signBit = 1ULL << (width - 1);
        const unsigned __int128 rawDividend =
            (static_cast<unsigned __int128>(PSrcReg1 & widthMask) << width) |
            static_cast<unsigned __int128>(Rax & widthMask);
        const uint64_t divisorBits = op2 & widthMask;
        if (divisorBits == 0) {
            fault = std::make_shared<DivideError>();
        } else {
            const bool dividendNegative = (PSrcReg1 & signBit) != 0;
            const bool divisorNegative = (divisorBits & signBit) != 0;
            unsigned __int128 dividendMagnitude = rawDividend;
            if (dividendNegative) {
                dividendMagnitude = (~rawDividend) + 1;
                if (width != 64) {
                    const unsigned __int128 doubleMask =
                        (static_cast<unsigned __int128>(1) << (2 * width)) - 1;
                    dividendMagnitude &= doubleMask;
                }
            }
            const uint64_t divisorMagnitude = divisorNegative ?
                ((~divisorBits) + 1) & widthMask : divisorBits;
            const unsigned __int128 quotientMagnitude =
                dividendMagnitude / divisorMagnitude;
            const unsigned __int128 remainderMagnitude =
                dividendMagnitude % divisorMagnitude;
            const bool quotientNegative = dividendNegative != divisorNegative;
            const unsigned __int128 quotientLimit =
                (static_cast<unsigned __int128>(1) << (width - 1)) -
                (quotientNegative ? 0 : 1);
            if (quotientMagnitude > quotientLimit) {
                fault = std::make_shared<DivideError>();
            } else {
                uint64_t quotient =
                    static_cast<uint64_t>(quotientMagnitude) & widthMask;
                uint64_t remainder =
                    static_cast<uint64_t>(remainderMagnitude) & widthMask;
                if (quotientNegative)
                    quotient = ((~quotient) + 1) & widthMask;
                if (dividendNegative)
                    remainder = ((~remainder) + 1) & widthMask;
                Quotient = quotient;
                Remainder = remainder;
                Divisor = divisorBits;
            }
        }
    '''

    def makeCompactCore(name, opClass, code):
        return type(name, (WrRegOp,), {
            "op_class": opClass,
            "code": code,
        })

    CompactDiv32 = makeCompactCore(
        "CompactDiv32", "X86IntDiv32Op", compactUnsignedCode)
    CompactIdiv32 = makeCompactCore(
        "CompactIdiv32", "X86IntDiv32Op", compactSignedCode)
    CompactDiv64 = makeCompactCore(
        "CompactDiv64", "X86IntDiv64Op", compactUnsignedCode)
    CompactIdiv64 = makeCompactCore(
        "CompactIdiv64", "X86IntDiv64Op", compactSignedCode)

    class CompactDivq(RdRegOp):
        op_class = "X86IntDivQuotOp"
        code = '''
            DestReg = merge(SrcReg1, dest, Quotient, dataSize);
            Divisor = Divisor;
        '''
        big_code = '''
            DestReg = Quotient & mask(dataSize * 8);
            Divisor = Divisor;
        '''

    def makeCompactRemainder(name, opClass):
        code = '''
            [[maybe_unused]] const uint64_t dependency = Divisor;
            DestReg = merge(SrcReg1, dest, Remainder, dataSize);
        '''
        bigCode = '''
            [[maybe_unused]] const uint64_t dependency = Divisor;
            DestReg = Remainder & mask(dataSize * 8);
        '''
        return type(name, (RdRegOp,), {
            "op_class": opClass,
            "code": code,
            "big_code": bigCode,
        })

    CompactDivr32 = makeCompactRemainder(
        "CompactDivr32", "X86IntDivRem32Op")
    CompactDivr64 = makeCompactRemainder(
        "CompactDivr64", "X86IntDivRem64Op")

    def compactDiv(name, core, remainder, width, extra):
        return '''
def macroop %s
{
    %s rdx, reg, dataSize=%d
    compactdivq rax, dataSize=%d
    %s rdx, dataSize=%d
    addi t7, t0, 0, dataSize=8
    %s
};
''' % (name, core, width, width, remainder, width, extra)

    microcode += compactDiv(
        "DIV_R_COMPACT32", "compactdiv32", "compactdivr32", 4, "")
    microcode += compactDiv(
        "IDIV_R_COMPACT32", "compactidiv32", "compactdivr32", 4, "")
    microcode += compactDiv(
        "DIV_R_COMPACT64", "compactdiv64", "compactdivr64", 8,
        'fault "NoFault"')
    microcode += compactDiv(
        "IDIV_R_COMPACT64", "compactidiv64", "compactdivr64", 8,
        'fault "NoFault"')
}};
