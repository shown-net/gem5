// Integer division stages carry real values; no padding operations.
let {{
    class Divprepare(WrRegOp):
        code = """
            ProdLow = Rax & mask(dataSize * 8);
            ProdHi = PSrcReg1 & mask(dataSize * 8);
        """

    class Divcheck(WrRegOp):
        code = """
            Divisor = PSrcReg1 & mask(dataSize * 8);
            if (Divisor == 0)
                fault = std::make_shared<DivideError>();
        """

    unsigned_quotient = """
        const unsigned width = dataSize * 8;
        const uint64_t divisor = op2 & mask(width);
        const unsigned __int128 dividend =
            (static_cast<unsigned __int128>(ProdHi) << width) | ProdLow;
        if (divisor == 0) {
            fault = std::make_shared<DivideError>();
        } else {
            const unsigned __int128 quotient = dividend / divisor;
            if (quotient > mask(width)) {
                fault = std::make_shared<DivideError>();
            } else {
                Quotient = static_cast<uint64_t>(quotient);
                Divisor = divisor;
            }
        }
    """
    signed_quotient = """
        const unsigned width = dataSize * 8;
        const uint64_t width_mask = mask(width);
        const uint64_t sign_bit = uint64_t(1) << (width - 1);
        const uint64_t divisor_bits = op2 & width_mask;
        const unsigned __int128 raw =
            (static_cast<unsigned __int128>(ProdHi) << width) | ProdLow;
        if (divisor_bits == 0) {
            fault = std::make_shared<DivideError>();
        } else {
            const bool negative_dividend = (ProdHi & sign_bit) != 0;
            const bool negative_divisor = (divisor_bits & sign_bit) != 0;
            unsigned __int128 magnitude = raw;
            if (negative_dividend) {
                magnitude = ~raw + 1;
                if (width < 64)
                    magnitude &= (static_cast<unsigned __int128>(1) <<
                                  (2 * width)) - 1;
            }
            const uint64_t divisor = negative_divisor ?
                (~divisor_bits + 1) & width_mask : divisor_bits;
            const unsigned __int128 quotient = magnitude / divisor;
            const bool negative = negative_dividend != negative_divisor;
            const unsigned __int128 limit =
                (static_cast<unsigned __int128>(1) << (width - 1)) -
                (negative ? 0 : 1);
            if (quotient > limit) {
                fault = std::make_shared<DivideError>();
            } else {
                const uint64_t value = static_cast<uint64_t>(quotient);
                Quotient = (negative ? ~value + 1 : value) & width_mask;
                Divisor = divisor_bits;
            }
        }
    """
    for width in (32, 64):
        for prefix, body in (("Div", unsigned_quotient),
                             ("Idiv", signed_quotient)):
            globals()[prefix + "quot" + str(width)] = type(
                prefix + "quot" + str(width), (WrRegOp,),
                {"code": body, "op_class": "IntDivOp"})

    # Full architectural results are formed once by the divider service.
    # O3 publishes them independently after the corresponding output action.
    for width in (32, 64):
        for prefix, body in (("Div", unsigned_quotient),
                             ("Idiv", signed_quotient)):
            pair = body.replace('ProdHi', 'dividend_high').replace(
                'ProdLow', 'dividend_low').replace('op2', 'PSrcReg1')
            pair = pair.replace('Quotient =', 'result_quotient =')
            pair = pair.replace('Divisor = divisor;', '').replace(
                'Divisor = divisor_bits;', '')
            pair = '''
                const uint64_t dividend_low = Rax & mask(dataSize * 8);
                const uint64_t dividend_high = Rdx & mask(dataSize * 8);
                uint64_t result_quotient = 0;
            ''' + pair + '''
                if (fault == NoFault) {
                    Rax = result_quotient;
                    Rdx = (dividend_low - result_quotient *
                           (PSrcReg1 & mask(dataSize * 8))) & mask(dataSize * 8);
                }
            '''
            globals()[prefix + "result" + str(width)] = type(
                prefix + "result" + str(width), (WrRegOp,),
                {"code": pair, "op_class": "IntDivOp"})

    class Divremainder(RegOp):
        operand_types = ()
        code = """
            // The low-width modular subtraction is valid for both signed
            // and unsigned division; it consumes the checked quotient.
            Remainder = (ProdLow - Quotient * Divisor) &
                        mask(dataSize * 8);
        """
        op_class = 'IntAluOp'

    class Divremainder64(Divremainder):
        op_class = 'IntAluOp'

    class Divwrite(RegOp):
        operand_types = ()
        code = """
            Rax = Quotient & mask(dataSize * 8);
            Rdx = Remainder & mask(dataSize * 8);
        """

    class Divwritebyte(RegOp):
        operand_types = ()
        code = """
            Rax = (Rax & ~uint64_t(0xffff)) |
                  (Quotient & 0xff) | ((Remainder & 0xff) << 8);
        """
}};
