    class Mulxhigh(Mulxlow):
        op_class = 'X86IntShiftOp'
        code = 'DestReg = ProdHi & mask(dataSize * 8);'

    class Mulxhigh64(Mulxhigh):
        op_class = 'X86IntMulResult64Op'

    class Crc32value(RegOp):
        op_class = 'X86Crc32Op'
        operand_types = (IntDestOp, IntSrc1Op, IntSrc2Op, Imm64Op)
        code = """
            uint32_t crc = uint32_t(SrcReg1);
            uint64_t input = pick(SrcReg2, src2, imm64);
            for (unsigned bit = 0; bit < imm64 * 8; ++bit) {
                const bool low = (crc ^ input) & 1;
                crc >>= 1;
                if (low) crc ^= 0x82f63b78U;
                input >>= 1;
            }
            DestReg = crc;
        """

    class Bswapword(RdRegOp):
        op_class = 'X86IntShiftOp'
        code = 'DestReg = uint64_t(__builtin_bswap16(SrcReg1));'

    class Bswapvalue(RdRegOp):
        op_class = 'X86ByteSwap32Op'
        code = """
            DestReg = dataSize == 4 ? uint64_t(__builtin_bswap32(SrcReg1)) :
                                      __builtin_bswap64(SrcReg1);
        """

    class Bswaplow(RdRegOp):
        op_class = 'X86ByteSwap32Op'
        code = 'DestReg = uint64_t(__builtin_bswap32(SrcReg1));'

    class Bswapjoin(BasicRegOp):
        op_class = 'X86IntShiftOp'
        code = """
            DestReg = (op2 << 32) |
                uint64_t(__builtin_bswap32(SrcReg1 >> 32));
        """
}};

let {{
    class Conditionbe(RegOp):
        operand_types = ()
        code = 'ConditionValue = ((cfofBits & CFBit) | (ccFlagBits & ZFBit)) != 0;'

    class Conditionnbe(RegOp):
        operand_types = ()
        code = 'ConditionValue = ((cfofBits & CFBit) | (ccFlagBits & ZFBit)) == 0;'

    class Setcondition(RdRegOp):
        code = 'DestReg = merge(SrcReg1, dest, ConditionValue, dataSize);'

    class Cmovcondition(BasicRegOp):
        code = 'DestReg = ConditionValue ? merge(SrcReg1, dest, op2, dataSize) : SrcReg1;'
        big_code = 'DestReg = (ConditionValue ? op2 : SrcReg1) & mask(dataSize * 8);'
}};
