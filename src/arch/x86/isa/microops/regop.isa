            const uint64_t value = ArithmeticResult & mask(width);
            const unsigned __int128 wide =
                static_cast<unsigned __int128>(left) + right + CarryInput;
            const bool carry = wide > mask(width);
            const uint64_t sign = uint64_t(1) << (width - 1);
            const bool overflow = (~(left ^ right) & (left ^ value)) & sign;
            uint64_t zaps = (value == 0 ? ZFBit : 0) |
                (value & sign ? SFBit : 0) |
