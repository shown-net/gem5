// Monitor Instruction

def template MonitorDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        %(reg_idx_arr_decl)s;

      public:
        %(class_name)s(ExtMachInst machInst);
        Fault execute(ExecContext *, trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          trace::InstRecord *) const override;
    };
}};

def template MonitorInitiateAcc {{
    Fault %(class_name)s::initiateAcc(ExecContext *xc,
            trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;
        if (Rcx != 0)
            return std::make_shared<GeneralProtection>(0);
        return initiateMemRead(xc, traceData, monitorAddress(xc, Rax),
                               1, monitorFlags());
    }
}};

def template MonitorCompleteAcc {{
    Fault %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
            trace::InstRecord *traceData) const
    {
        if (pkt)
            xc->armMonitor(pkt->req->getVaddr(), pkt->getAddr());
        return NoFault;
    }
}};

output header {{
    class MonitorInst : public X86ISA::X86StaticInst
    {
      public:
        static const RegIndex foldOBit = 0;
        Addr monitorAddress(ExecContext *, RegVal) const;
        Request::Flags monitorFlags() const;
        /// Constructor
        MonitorInst(const char *_mnemonic, ExtMachInst _machInst,
                OpClass __opClass) :
            X86ISA::X86StaticInst(_mnemonic, _machInst, __opClass)
        {
            // Arming the monitor is an architectural side effect, not a
            // speculative action on a path which may later be squashed.
            // A following condition check must not run before it is armed.
            flags[IsNonSpeculative] = 1;
            flags[IsSerializeAfter] = 1;
            flags[IsLoad] = 1;
        }

        std::string generateDisassembly(Addr pc,
                const loader::SymbolTable *symtab) const override;
    };
}};

output decoder {{
    std::string
    MonitorInst::generateDisassembly(
            Addr PC, const loader::SymbolTable *symtab) const
    {
        std::stringstream response;

        printMnemonic(response, mnemonic);
        return response.str();
    }
}};

output exec {{
    Addr
    MonitorInst::monitorAddress(ExecContext *xc, RegVal address) const
    {
        const int seg = machInst.legacy.seg ?
            machInst.legacy.seg - 1 : segment_idx::Ds;
        const bool flat = machInst.mode.submode == SixtyFourBitMode &&
            seg != segment_idx::Fs && seg != segment_idx::Gs;
        const Addr base = flat ? 0 :
            xc->tcBase()->readMiscReg(misc_reg::segBase(seg));
        return base + (address & mask(machInst.addrSize * 8));
    }

    Request::Flags
    MonitorInst::monitorFlags() const
    {
        const int seg = machInst.legacy.seg ?
            machInst.legacy.seg - 1 : segment_idx::Ds;
        return seg |
            ((log2i(machInst.addrSize) & AddrSizeFlagMask) << AddrSizeFlagShift);
    }
}};

def format MonitorInst(code, *opt_flags) {{
    iop = InstObjParams(name, Name, 'MonitorInst', code, opt_flags)
    iop.op_class = 'MemReadOp'
    header_output = MonitorDeclare.subst(iop)
    decoder_output = BasicConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    decode_block = '''
        if (machInst.mode.cpl != 0) {
            return new DecodeFaultInst("%(Name)s", machInst,
                    std::make_shared<InvalidOpcode>());
        }
        %(decode_block)s
    ''' % {'Name': Name, 'decode_block': decode_block}
    exec_output = BasicExecute.subst(iop)
    exec_output += MonitorInitiateAcc.subst(iop)
    exec_output += MonitorCompleteAcc.subst(iop)
}};


// Mwait instruction

output header {{
    class MwaitInst : public X86ISA::X86StaticInst
    {
      public:
        static const RegIndex foldOBit = 0;
        /// Constructor
        MwaitInst(const char *_mnemonic, ExtMachInst _machInst,
                OpClass __opClass) :
            X86ISA::X86StaticInst(_mnemonic, _machInst, __opClass)
        {
            // Sleeping is a side effect. Prevent execution on a wrong path,
            // and hold younger instructions until this wait has retired.
            // IsQuiesce is unsuitable because MWAIT can also return without
            // suspending, in which case no wakeup would restart fetch.
            flags[IsNonSpeculative] = 1;
            flags[IsSerializeAfter] = 1;
        }

        std::string generateDisassembly(Addr pc,
                const loader::SymbolTable *symtab) const override;
    };
}};

output decoder {{
    std::string
    MwaitInst::generateDisassembly(
            Addr PC, const loader::SymbolTable *symtab) const
    {
        std::stringstream response;

        // Although mwait could take hints from eax and ecx, the srcRegIdx
        // is not set, and thus should not be printed here
        printMnemonic(response, mnemonic);
        return response.str();
    }
}};

def format MwaitInst(code, *opt_flags) {{
    iop = InstObjParams(name, Name, 'MwaitInst', code, opt_flags)
    header_output = BasicDeclare.subst(iop)
    decoder_output = BasicConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    decode_block = '''
        if (machInst.mode.cpl != 0) {
            return new DecodeFaultInst("%(Name)s", machInst,
                    std::make_shared<InvalidOpcode>());
        }
        %(decode_block)s
    ''' % {'Name': Name, 'decode_block': decode_block}
    exec_output = BasicExecute.subst(iop)
}};
